{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/catalogo", "destination": "/index.html" },
    { "source": "/livros", "destination": "/index.html" },
    { "source": "/biblioteca", "destination": "/index.html" },
    { "source": "/autores", "destination": "/index.html" },
    { "source": "/publicar", "destination": "/index.html" },
    { "source": "/ler", "destination": "/index.html" },
    { "source": "/perfil", "destination": "/index.html" },
    { "source": "/conta", "destination": "/index.html" }
  ]
}
