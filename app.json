{
  "expo": {
    "name": "RPgram",
    "slug": "rpgram",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "rpgram",
    "splash": {
      "backgroundColor": "#07070A",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.rpgram.app",
      "adaptiveIcon": {
        "backgroundColor": "#07070A",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rpgram.app"
    },
    "plugins": [
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "d02dd6bc-3716-4070-ae11-70e3a86bc93d"
      }
    }
  }
}
